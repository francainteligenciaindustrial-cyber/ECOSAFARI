# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Calendar OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Database Credentials
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Supabase service_role key (Settings > API > service_role secret). Server-side
# only — lets the backend bypass RLS for its own trusted operations, while RLS
# stays locked down for anyone hitting Supabase directly with the anon key.
# NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe: ativa o checkout real de pagamento (chave secreta, começa com sk_).
# Sem isso, o chatbot usa o botão de "Simular Pagamento".
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"

# Stripe webhook signing secret (Dashboard > Developers > Webhooks > sua
# URL /api/stripe/webhook > Signing secret, começa com whsec_). Sem isso, o
# endpoint fica inativo e a confirmação de pagamento depende só do navegador
# do cliente voltar pra /pagamento-confirmado.
STRIPE_WEBHOOK_SECRET=""

# Resend: ativa o email automático de confirmação de reserva com voucher em PDF.
# Crie uma conta gratuita em resend.com e gere uma API Key.
RESEND_API_KEY="MY_RESEND_API_KEY"

# reCAPTCHA v3 (google.com/recaptcha/admin, tipo "v3", sem checkbox visível).
# Sem essas duas chaves, o formulário de parceiros/candidaturas funciona
# normalmente, só sem a proteção anti-bot.
# VITE_RECAPTCHA_SITE_KEY é pública (vai pro navegador) — RECAPTCHA_SECRET_KEY
# é privada, só o backend usa.
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Sentry (sentry.io, crie um projeto React e um Node, ou um só e use o mesmo
# DSN nos dois). Sem isso, erros só aparecem no console/logs — nada é
# reportado externamente.
VITE_SENTRY_DSN=""
SENTRY_DSN=""

# Meta Pixel (business.facebook.com/events_manager > Fontes de dados > seu
# pixel > ID do Pixel, um número). Sem isso, os anúncios no Meta (Facebook/
# Instagram) não conseguem medir quantos cadastros de parceiro vieram do
# anúncio nem otimizar a entrega — o pixel só é criado/carregado se essa
# variável estiver definida.
VITE_META_PIXEL_ID=""

# Identidade institucional exibida no rodapé do site (CNPJ e endereço) —
# obrigatório para um site público de reservas/pagamento parecer legítimo e
# para a divulgação de controlador de dados exigida pela LGPD. Sem essas
# variáveis, o rodapé mostra um aviso de placeholder pedindo para preencher.
VITE_COMPANY_CNPJ=""
VITE_COMPANY_ADDRESS=""

